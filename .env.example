SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
MUSICBRAINZ_USER_AGENT=1001AlbumsEnrichment/1.0 (your-email@example.com)

# Dutch -> English translation of review text/captions (translate.py),
# both the one-off backfill (translate_content.py) and the ongoing
# incremental step inside enrich_1001_albums.py's sync_posts()
ANTHROPIC_API_KEY=

# Admin panel (server.py) — single shared HTTP Basic Auth login, no
# per-user accounts (single-user tool)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Only needed in production (Coolify), where the app runs at a subpath
# behind a proxy that strips it — set to /1001albums there. Leave unset
# for local dev (defaults to "", i.e. root).
BASE_PATH=
