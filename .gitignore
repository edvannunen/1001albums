*.pyc
.claude/
.venv/

# SQLite database files — schema.sql + migrate_json_to_sqlite.py are the
# source of truth in git; the actual .db is runtime data (production's
# lives on a Coolify persistent volume, not in the repo)
*.db
*.db-shm
*.db-wal

# editor + local reference/scratch files, not site assets
.vscode/

# Throwaway scripts (repros, one-off debug/data scripts). Always reused at this
# fixed path rather than named uniquely, so its permission-allow entry doesn't
# go stale every time the file's contents change.
scratchpad/
